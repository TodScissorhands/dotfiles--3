#!/bin/sh

# Reuse and focus the RMPC terminal when one is already open in this compositor.
/home/tod/.local/bin/rmpc-session focus >/dev/null 2>&1
status=$?
case "$status" in
    0) exit 0 ;;
    1) ;;
    *) exit "$status" ;;
esac

exec /usr/bin/ghostty --title=rmpc-stop-on-exit -e /home/tod/.local/bin/rmpc-terminal-session
