#!/bin/sh

# Run RMPC tied to its Ghostty window. Some terminal-close paths do not forward
# a signal to child processes, so watch the compositor window and stop MPD when it disappears.
/usr/bin/rmpc "$@" &
child=$!

stop_and_exit() {
    kill "$child" 2>/dev/null || true
    /usr/bin/rmpc stop >/dev/null 2>&1 || true
    wait "$child" 2>/dev/null || true
}
trap stop_and_exit EXIT HUP INT TERM

# Give Ghostty and the active compositor time to register the window.
sleep 1
while kill -0 "$child" 2>/dev/null; do
    /home/tod/.local/bin/rmpc-session exists >/dev/null 2>&1
    status=$?
    if [ "$status" -eq 1 ]; then
        exit 0
    fi
    sleep 0.5
done
wait "$child"
