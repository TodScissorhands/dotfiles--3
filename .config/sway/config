# Personal Sway configuration
# Mod = Super/Windows key. Reload after editing with Mod+Shift+C.

### Appearance and applications
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $browser env MOZ_ENABLE_WAYLAND=1 firefox
set $lock /home/tod/.local/bin/tod-lock
set $term ghostty 
set $menu fuzzel

font pango:GeistMono Nerd Font Mono 11
gaps inner 2
gaps outer 2
default_border pixel 1
default_floating_border normal 2
smart_gaps off
smart_borders on
focus_follows_mouse no
focus_on_window_activation focus
# Keep workspace number keys predictable: Super+1 always stays on workspace 1.
workspace_auto_back_and_forth no

include /home/tod/.cache/wal/sway-colors

### Outputs and input
# A 13-inch 1080p laptop is physically dense; make every Wayland app and
# Sway's own interface 25% larger.
output * scale 1.25

input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
    middle_emulation enabled
}

# Three-finger trackpad swipes switch between workspaces.
bindgesture swipe:3:left workspace next
bindgesture swipe:3:right workspace prev

### Startup
exec --no-startup-id swayidle -w \
    before-sleep '$lock'
# The laptop remains unlocked while idle. Manual locking remains available
# with Super+Escape; the lock wrapper hibernates after 10 minutes locked.
bindswitch --locked lid:on exec $lock
exec --no-startup-id /home/tod/.config/fish/scripts/wallpaper-ctl.fish restore
exec --no-startup-id udiskie --tray
exec --no-startup-id waybar
exec --no-startup-id /home/tod/.local/bin/wlsunset-toggle --start
exec wl-paste --watch cliphist store

### Core controls
bindsym $mod+Return exec $term
bindsym $mod+m exec --no-startup-id /home/tod/.local/bin/rmpc-launch
bindsym $mod+d exec $menu
bindsym $mod+Shift+y exec $term -e yazi
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes, exit' 'swaymsg exit'
bindsym $mod+Escape exec $lock
bindsym --locked XF86PowerOff exec swaynag -t warning -m 'Power off this laptop?' -B 'Cancel' true -B 'Power off' 'systemctl poweroff'
bindsym $mod+Ctrl+p exec pavucontrol
bindsym $mod+o exec /home/tod/.local/bin/audio-output
bindsym $mod+Shift+v exec /home/tod/.local/bin/cliphist-picker
bindsym $mod+x exec /home/tod/.local/bin/sys-menu
# Wallpaper picker: Super+Shift+W opens Yazi; Super+Ctrl+W advances the
# selected theme's images. Super+W remains the tabbed-layout binding below.
bindsym $mod+Alt+w exec /home/tod/.config/fish/scripts/wallpaper-picker.fish
bindsym $mod+Shift+w exec /home/tod/.config/fish/scripts/wallpaper-next.fish

# warpd pointer control (Wayland: standalone, compositor-launched modes).
# There is intentionally no `exec warpd` daemon here: each invocation owns
# its grab and exits when its selected mode is complete.
bindsym $mod+Mod1+x exec /home/tod/.local/bin/warpd-sway --hint --oneshot --click 1
bindsym $mod+Mod1+c exec /home/tod/.local/bin/warpd-sway --normal
bindsym $mod+Mod1+g exec /home/tod/.local/bin/warpd-sway --grid
# Emergency recovery if a warpd overlay stops accepting keyboard input.
bindsym --locked $mod+Mod1+Escape exec pkill -KILL -x warpd

# Dedicated terminal file chooser. Ghostty's GTK backend keeps a generic
# Wayland app_id, so the portal wrapper supplies this stable title.
for_window [title="^(FileUploadPicker|Wallpaper Picker)$"] floating enable, resize set width 1000 px height 700 px, move position center


# Focus and move windows
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Tab workspace back_and_forth

# Layout, floating windows, and scratchpad
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f exec $browser
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
floating_modifier $mod normal
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

mode "resize" {
    bindsym $left resize shrink width 10 px or 10 ppt
    bindsym $down resize grow height 10 px or 10 ppt
    bindsym $up resize shrink height 10 px or 10 ppt
    bindsym $right resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Hardware keys and screenshots
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume -l 2.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 2.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec --no-startup-id swaymsg -t get_tree | grep -q 'rmpc-stop-on-exit' && /usr/bin/rmpc togglepause
bindsym --locked XF86AudioPause exec --no-startup-id swaymsg -t get_tree | grep -q 'rmpc-stop-on-exit' && /usr/bin/rmpc togglepause
bindsym --locked XF86AudioPrev exec --no-startup-id swaymsg -t get_tree | grep -q 'rmpc-stop-on-exit' && /usr/bin/rmpc prev
bindsym --locked XF86AudioNext exec --no-startup-id swaymsg -t get_tree | grep -q 'rmpc-stop-on-exit' && /usr/bin/rmpc next
bindsym --locked XF86AudioStop exec --no-startup-id swaymsg -t get_tree | grep -q 'rmpc-stop-on-exit' && /usr/bin/rmpc stop
# RMPC/MPD playback controls on the function row.
bindsym --locked F9  exec --no-startup-id swaymsg -t get_tree | grep -q 'rmpc-stop-on-exit' && /usr/bin/rmpc play
bindsym --locked F10 exec --no-startup-id swaymsg -t get_tree | grep -q 'rmpc-stop-on-exit' && /usr/bin/rmpc togglepause
bindsym --locked F11 exec --no-startup-id swaymsg -t get_tree | grep -q 'rmpc-stop-on-exit' && /usr/bin/rmpc next
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set +5%
# Screenshots: save a PNG and copy that image to the Wayland clipboard.
bindsym $mod+p exec sh -c 'dir=/home/tod/Pictures/Screenshots; mkdir -p "$dir"; file="$dir/Screenshot-$(date +%F-%H%M%S).png"; grim -g "$(slurp)" "$file" && wl-copy --type image/png < "$file"'
bindsym $mod+Shift+p exec sh -c 'dir=/home/tod/Pictures/Screenshots; mkdir -p "$dir"; file="$dir/Screenshot-$(date +%F-%H%M%S).png"; grim "$file" && wl-copy --type image/png < "$file"'

include /etc/sway/config.d/*
